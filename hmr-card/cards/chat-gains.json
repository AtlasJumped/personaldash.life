     "chat.1.r0"
    ],
    [
     "type",
     "chat.1.r1",
     "Sleep|example: steady"
    ],
    [
     "click",
     "chat.1.r1"
    ],
    [
     "type",
     "chat.1.r2",
     "Meals|example: logged"
    ],
    [
     "click",
     "chat.1.r2"
    ],
    [
